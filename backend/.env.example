PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# LLM Configuration (OpenAI, Gemini OpenAI-compatible, Groq, etc.)
