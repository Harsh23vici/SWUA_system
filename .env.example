# ================================================================
# Smart Water Usage Advisor - Environment Variables
# ================================================================

# Port and Host
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI / LLM Configuration
# Supports OpenAI, Google Gemini (OpenAI compatible endpoint), Groq, OpenRouter, etc.
# If LLM_API_KEY is not provided, the application runs in smart local fallback mode
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Frontend environment (used if deployed together or for references)
VITE_API_BASE_URL=http://localhost:8000/api
