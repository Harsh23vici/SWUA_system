# ================================================================
# Smart Water Usage Advisor - Environment Variables
# ================================================================

# API Settings
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated, use * for production if unified domain, or frontend Vercel URL)
ALLOWED_ORIGINS=*

# AI / LLM Configuration
# Supports OpenAI, Google Gemini (OpenAI compatible endpoint), Groq, OpenRouter, etc.
# If LLM_API_KEY is not provided, the application runs in smart local fallback mode
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20.0

# Frontend environment (Empty for unified Vercel deployment)
VITE_API_BASE_URL=/api
